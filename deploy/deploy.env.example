# Copy to deploy/deploy.env (gitignored) and fill in. Read by deploy/publish-gar.sh.
# Never commit the real file: it names private registries, projects and clusters.

# Docker CLI to use. On Windows 11 + WSL: DOCKER="wsl docker"
DOCKER="docker"

# Google Artifact Registry: <GAR_LOCATION>-docker.pkg.dev/<GCLOUD_PROJECT>/<GAR_REPOSITORY>/<IMAGE>
GCLOUD_PROJECT="<gcp-project-id>"
GAR_LOCATION="<region>"                 # e.g. us-east1
GAR_REPOSITORY="<artifact-registry-repo>"
IMAGE="akash-console-air"

# gcloud context pinned for this deploy only (the globally active configuration is not changed).
# Named configuration from `gcloud config configurations list`; its account is used unless
# GCLOUD_ACCOUNT overrides it. GCLOUD_PROJECT above always wins as the project.
GCLOUD_CONFIGURATION="<gcloud-configuration>"
GCLOUD_ACCOUNT=""                       # optional, e.g. a CI service account

# Service-account key with push rights on the registry (keep it out of git).
# Leave empty to use the docker credential helper from `gcloud auth configure-docker`.
GAR_SA_KEY_FILE="deploy/<service-account-key>.json"

# Build: subpath the app is served under (blank = origin root).
BASE_PATH="/akash-console"

# GKE target
GKE_CLUSTER="<gke-cluster-name>"
GKE_LOCATION="<region-or-zone>"
# kubectl context used explicitly for apply (default: gke_<project>_<location>_<cluster>, the name
# get-credentials creates). The caller's current-context is restored when the script exits.
KUBE_CONTEXT=""
K8S_MANIFEST="deploy/k8s/gke.deployment.template.yaml"
REPLICAS=1
